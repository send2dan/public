library(tidyverse)
clinic <- tibble(
nhs_number = c(
"6102856147",
"8603999554",
"1344099904",
"4476198708",
"1418785687",
"8900882554",
"8117212838",
"1863656030",
"5943089063",
"8455434074",
"7960211663",
"6494169953",
"2249060851",
"4456239204",
"1420068040"
),
clinic_date = as.Date(c(
"2026-10-01",
"2026-10-01",
"2026-10-08",
"2026-10-15",
"2026-10-01",
"2026-10-08",
"2026-10-15",
"2026-10-08",
"2026-10-15",
"2026-10-01",
"2026-10-08",
"2026-10-15",
"2026-10-01",
"2026-10-08",
"2026-10-15"
)),
new_or_follow = c(
"new", "follow", "follow", "new", "new",
"follow", "new", "follow", "new", "follow",
"new", "follow", "new", "follow", "new"
)
)
# Dummy hepatitis D antibody testing data
hepd_ab <- tibble(
nhs_number = c(
"8603999554",
"4476198708",
"8455434074",
"7960211663",
"6494169953",
"2249060851"
),
test_date = as.Date(c(
"2026-10-01",
"2026-10-15",
"2026-10-02",
"2026-10-10",
"2026-10-16",
"2026-10-20"
)),
test = "hepd_ab",
result = c(
"DET",
"NDET",
"NDET",
"DET",
"NDET",
"DET"
)
)
clinic_hepd <- clinic %>%
left_join(
hepd_ab,
by = "nhs_number"
) %>%
mutate(
tested_hepd_ab = if_else(
!is.na(test_date),
"Yes",
"No"
)
)
View(clinic_hepd)
View(clinic)
View(hepd_ab)
View(clinic_hepd)
tested <- clinic_hepd %>%
filter(!is.na(test_date))
tested
testing_summary <- clinic_hepd %>%
summarise(
total_patients = n_distinct(nhs_number),
tested = n_distinct(nhs_number[!is.na(test_date)]),
not_tested = n_distinct(nhs_number[is.na(test_date)]),
percentage_tested = round(
tested / total_patients * 100, 1
)
)
testing_summary
testing_summary <- clinic_hepd %>%
summarise(
total_patients = n_distinct(nhs_number),
tested = n_distinct(nhs_number[!is.na(test_date)]),
not_tested = n_distinct(nhs_number[is.na(test_date)]),
percentage_tested = round(
tested / total_patients * 100, 1
)
)
clinic_hepd %>%
group_by(new_or_follow) %>%
summarise(
total_patients = n_distinct(nhs_number),
tested = n_distinct(nhs_number[!is.na(test_date)]),
percentage_tested = round(
tested / total_patients * 100, 1
),
.groups = "drop"
)
