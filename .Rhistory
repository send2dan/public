)
clinic_hepd <- clinic %>%
left_join(
hepd_ab,
by = "nhs_number"
) %>%
mutate(
tested_hepd_ab = if_else(
!is.na(test_date),
"Yes",
"No"
)
)
tested <- clinic_hepd %>%
filter(!is.na(test_date))
not_tested <- clinic_hepd %>%
filter(is.na(test_date))
testing_summary <- clinic_hepd %>%
summarise(
total_patients = n_distinct(nhs_number),
tested = n_distinct(nhs_number[!is.na(test_date)]),
not_tested = n_distinct(nhs_number[is.na(test_date)]),
percentage_tested = round(
tested / total_patients * 100, 1
)
)
testing_summary
testing_by_attendance <- clinic_hepd %>%
group_by(new_or_follow) %>%
summarise(
total_patients = n_distinct(nhs_number),
tested = n_distinct(nhs_number[!is.na(test_date)]),
not_tested = n_distinct(nhs_number[is.na(test_date)]),
percentage_tested = round(
tested / total_patients * 100, 1
),
.groups = "drop"
)
testing_by_attendance
clinic_hepd %>%
select(
nhs_number,
clinic_date,
new_or_follow,
tested_hepd_ab,
test_date,
test,
result
)
clinic_hepd %>%
count(tested_hepd_ab) %>%
mutate(
tested_hepd_ab = factor(
tested_hepd_ab,
levels = c("Yes", "No"),
labels = c("Tested", "Not tested")
),
percentage = n / sum(n)
) %>%
ggplot(aes(x = tested_hepd_ab, y = n, fill = tested_hepd_ab)) +
geom_col(width = 0.6) +
geom_text(
aes(label = paste0(n, " (", percent(percentage), ")")),
vjust = -0.5,
size = 5
) +
scale_fill_manual(
values = c("Tested" = "#238B75", "Not tested" = "#D95F59")
) +
labs(
title = "Hepatitis D antibody testing uptake",
subtitle = "Patients attending clinic, October 2026",
x = NULL,
y = "Number of patients"
) +
theme_minimal(base_size = 14) +
theme(
legend.position = "none",
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
) +
expand_limits(y = 15)
