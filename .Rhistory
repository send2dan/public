hepd_ab <- tibble(
nhs_number = c(
"6102856147",
"8603999554",
"1344099904",
"4476198708",
"1418785687",
"8117212838",
"1863656030",
"5943089063",
"8455434074",
"7960211663",
"6494169953",
"2249060851"
),
test_date = as.Date(c(
"2026-10-01",
"2026-10-01",
"2026-10-09",
"2026-10-15",
"2026-10-02",
"2026-10-16",
"2026-10-09",
"2026-10-20",
"2026-10-02",
